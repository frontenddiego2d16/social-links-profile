---
import AvatarImg from "../assets/avatar-jessica.jpeg";
---

<article class="bg-background flex flex-col items-center p-5 gap-5">
  <figure class="p-1.5 rounded-full bg-gradient-to-r from-primary via-secondary to-primary shadow-avatar animate-move-gradient bg-size-[300%_300%] w-28 h-28">
    <img src={AvatarImg.src} alt="Avatar-Jessica" class="rounded-full" />
  </figure>

  <div class="flex flex-col items-center gap-1">
    <h1 class="text-text-primary text-xl font-bold">Jessica Randall</h1>
    <h3 class="text-location font-semibold text-sm">&gt; London, United Kingdom &lt;</h3>

    <p class="text-cyan-600 italic text-xs">"Front-end developer and avid reader"</p>
  </div>

</article>


<style>
  .shadow-avatar{
    box-shadow: 0 0 10px greenyellow,
    0 0 20px cyan;
  }
</style>